@page "/"
@inherits LocationPageBase

<PageTitle>WattWeather — Your city's energy story</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <span class="kicker">LOCAL WEATHER / ENERGY INTELLIGENCE</span>
        <h1>Know whether solar makes sense <em>where you live.</em></h1>
        <p>One city search connects sunshine, weather pressure, electricity prices, power sources, and available solar help.</p>
        <div class="hero-actions">
            <a class="btn btn-dark" href="#city">Build my snapshot <span>↘</span></a>
            <a class="btn btn-outline" href="solar">Explore solar</a>
        </div>
        <div class="proof"><span>Public data</span><span>No account</span><span>Plain English</span></div>
    </div>
    <div class="product-preview">
        <div class="preview-bar"><span>WATTWEATHER / LIVE SIGNAL</span><i></i><i></i><i></i></div>
        <div class="preview-body">
            <span class="preview-label">CURRENT LOCATION</span>
            <strong>@(City?.Name ?? "Choose your city")</strong>
            <div class="preview-grid">
                <article><span>WEATHER</span><b>@(Forecast is null ? "—" : $"{Math.Round(Forecast.Current.Temperature)}°F")</b><small>@(Forecast is null ? "Waiting for data" : EnergyCalculations.WeatherLabel(Forecast.Current.WeatherCode))</small></article>
                <article class="signal"><span>SOLAR SCORE</span><b>@(Solar is null ? "—" : $"{Solar.Score}/100")</b><small>@(Solar?.Verdict ?? "Waiting for data")</small></article>
            </div>
            <div class="preview-line"><i style="width:@(Solar?.Score ?? 0)%"></i></div>
        </div>
    </div>
</section>

<section id="city" class="search-band">
    <div><span class="kicker">START HERE</span><h2>What is your city's energy story?</h2></div>
    <CityPicker Selected="LoadCityAsync" ButtonText="Build snapshot" />
</section>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert">@Error</div>
}

<section class="page-section">
    <div class="section-intro">
        <span class="kicker">ONE QUESTION AT A TIME</span>
        <h2>A focused page for every decision.</h2>
    </div>
    <div class="feature-grid">
        <a class="feature-card accent-card" href="solar"><span>01 / SOLAR</span><h3>Is solar worth it?</h3><p>Estimate a typical 6 kW, 15-panel system with local sunlight and state rates.</p><b>Open solar report ↗</b></a>
        <a class="feature-card" href="discounts"><span>02 / DISCOUNTS</span><h3>What help can I get?</h3><p>Understand the federal status and estimate confirmed state or utility rebates.</p><b>Check discounts ↗</b></a>
        <a class="feature-card" href="weather-impact"><span>03 / WEATHER</span><h3>Does weather raise use?</h3><p>Translate hot and cold conditions into heating and cooling pressure.</p><b>See weather impact ↗</b></a>
        <a class="feature-card" href="power"><span>04 / GRID</span><h3>What powers my state?</h3><p>See the source that typically leads the state's electricity generation.</p><b>Explore the grid ↗</b></a>
    </div>
</section>

@if (City is not null && Forecast is not null)
{
    <section class="snapshot">
        <div><span class="kicker">LOCAL SNAPSHOT</span><h2>@City.Name, in four numbers.</h2></div>
        <div class="metric-grid">
            <article><span>Current temperature</span><strong>@Math.Round(Forecast.Current.Temperature)°F</strong><small>@EnergyCalculations.WeatherLabel(Forecast.Current.WeatherCode)</small></article>
            <article><span>Solar resource</span><strong>@(Solar?.DailySolarKwhPerSquareMeter.ToString("0.0"))</strong><small>kWh/m² daily forecast avg.</small></article>
            <article><span>State home use</span><strong>@(StateEnergy is null ? "—" : $"{StateEnergy.AverageMonthlyKwh:N0}")</strong><small>kWh/month · EIA</small></article>
            <article><span>State home rate</span><strong>@(StateEnergy is null ? "—" : $"{StateEnergy.ResidentialPriceCents:0.00}¢")</strong><small>per kWh · EIA @StateEnergy?.Period</small></article>
        </div>
    </section>
}

@code {
    private SolarEstimate? Solar { get; set; }

    protected override Task OnLocationLoadedAsync()
    {
        Solar = Forecast is null ? null : Calculations.CalculateSolar(Forecast, StateEnergy);
        return Task.CompletedTask;
    }
}
