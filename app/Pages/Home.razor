@page "/"
@inherits LocationPageBase
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@ShareTitle</PageTitle>
<HeadContent>
    <meta property="og:title" content="@ShareTitle" />
    <meta property="og:description" content="@ShareDescription" />
    <meta name="twitter:title" content="@ShareTitle" />
    <meta name="twitter:description" content="@ShareDescription" />
</HeadContent>

<section class="weather-hero">
    <div>
        <span class="kicker">YOUR WEATHER, MINUS THE CLUTTER</span>
        <h1>What’s it doing <em>outside?</em></h1>
        <p>Type any U.S. city or ZIP code. Get current conditions, today’s details, and a friendly seven-day forecast.</p>
        <div class="proof"><span>Live weather</span><span>No account</span><span>U.S. locations</span></div>
    </div>
    <div class="weather-orb @WeatherMood">
        <span class="weather-emoji">@WeatherPresentation.Emoji(Forecast?.Current.WeatherCode ?? 0, Forecast?.Current.IsDay != 0)</span>
        <strong>@(Forecast is null ? "Hello!" : $"{Math.Round(Forecast.Current.Temperature)}°")</strong>
        <small>@(Forecast is null ? "Pick a place to begin" : WeatherPresentation.Label(Forecast.Current.WeatherCode))</small>
    </div>
</section>

<section id="weather-search" class="search-band">
    <div><span class="kicker">FIND YOUR FORECAST</span><h2>City or ZIP code</h2></div>
    <CityPicker Selected="SelectCityAsync" ButtonText="Show me the weather" />
</section>

@if (!string.IsNullOrWhiteSpace(Error)) { <div class="alert">@Error</div> }
@if (Loading)
{
    <section class="snapshot snapshot-skeleton" aria-label="Loading weather" aria-busy="true">
        <div class="skeleton-line wide"></div>
        <div class="metric-grid">
            @for (var index = 0; index < 6; index++) { <article><span class="skeleton-line"></span><strong class="skeleton-block"></strong><small class="skeleton-line"></small></article> }
        </div>
    </section>
}

@if (!Loading && City is not null && Forecast is not null)
{
    <section class="weather-dashboard">
        <div class="weather-heading">
            <div><span class="kicker">RIGHT NOW</span><h2>@City.Name, @City.State</h2><p>@WeatherPresentation.Label(Forecast.Current.WeatherCode) · @Forecast.TimezoneAbbreviation</p></div>
            <button class="text-button" type="button" @onclick="ShareAsync">Share this forecast ↗</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_shareStatus)) { <p class="field-status">@_shareStatus</p> }

        <div class="current-weather">
            <article class="temperature-card">
                <span class="giant-emoji">@WeatherPresentation.Emoji(Forecast.Current.WeatherCode, Forecast.Current.IsDay != 0)</span>
                <strong>@Math.Round(Forecast.Current.Temperature)°F</strong>
                <p>Feels like @Math.Round(Forecast.Current.FeelsLike)°F</p>
                <small>H @TodayHigh° · L @TodayLow°</small>
            </article>
            <div class="weather-specs">
                <article><span>💧 Humidity</span><strong>@Forecast.Current.Humidity.ToString("0")%</strong></article>
                <article><span>💨 Wind</span><strong>@Forecast.Current.WindSpeed.ToString("0") mph @WeatherPresentation.WindDirection(Forecast.Current.WindDirection)</strong></article>
                <article><span>☔ Rain now</span><strong>@Forecast.Current.Precipitation.ToString("0.00") in</strong></article>
                <article><span>☁️ Cloud cover</span><strong>@Forecast.Current.CloudCover.ToString("0")%</strong></article>
                <article><span>🌡️ Pressure</span><strong>@Forecast.Current.SurfacePressure.ToString("0") hPa</strong></article>
                <article><span>🧴 UV index</span><strong>@TodayUv</strong></article>
                <article><span>🌅 Sunrise</span><strong>@FormatTime(Forecast.Daily.Sunrises.ElementAtOrDefault(0))</strong></article>
                <article><span>🌇 Sunset</span><strong>@FormatTime(Forecast.Daily.Sunsets.ElementAtOrDefault(0))</strong></article>
            </div>
        </div>

        <div class="forecast-heading"><span class="kicker">NEXT 7 DAYS</span><h2>Your week at a glance</h2></div>
        <div class="forecast-grid">
            @foreach (var day in ForecastDays)
            {
                <article class="forecast-card">
                    <span>@day.Name</span>
                    <b>@WeatherPresentation.Emoji(day.Code)</b>
                    <strong>@day.High° <small>@day.Low°</small></strong>
                    <p>@WeatherPresentation.Label(day.Code)</p>
                    <small>☔ @day.RainChance% · 💨 @day.Wind mph</small>
                </article>
            }
        </div>
        <div class="weather-note">Forecast data from Open-Meteo. Conditions can change, so check local alerts during severe weather.</div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "city")] public string? SharedCity { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? SharedState { get; set; }
    private string? _loadedShare;
    private string? _shareStatus;
    private string ShareTitle => City is null ? "WattWeather — Simple, fun U.S. weather" : $"{City.Name} weather — WattWeather";
    private string ShareDescription => City is null ? "Search any U.S. city or ZIP for current conditions and a seven-day forecast." : $"{Math.Round(Forecast?.Current.Temperature ?? 0)}°F and {WeatherPresentation.Label(Forecast?.Current.WeatherCode ?? 0)} in {City.Name}.";
    private string WeatherMood => (Forecast?.Current.WeatherCode ?? 0) switch { 0 or 1 => "sunny", >= 71 and <= 77 => "snowy", >= 85 and <= 86 => "snowy", >= 95 => "stormy", >= 51 and <= 82 => "rainy", _ => "cloudy" };
    private string TodayHigh => Math.Round(Forecast?.Daily.Highs.ElementAtOrDefault(0) ?? 0).ToString("0");
    private string TodayLow => Math.Round(Forecast?.Daily.Lows.ElementAtOrDefault(0) ?? 0).ToString("0");
    private string TodayUv => (Forecast?.Daily.UvIndex.ElementAtOrDefault(0) ?? 0).ToString("0.0");
    private IEnumerable<ForecastDay> ForecastDays => Enumerable.Range(0, Math.Min(7, Forecast?.Daily.Dates.Count ?? 0)).Select(index => new ForecastDay(
        index == 0 ? "Today" : DateTime.Parse(Forecast!.Daily.Dates[index]).ToString("ddd"),
        Forecast!.Daily.WeatherCodes.ElementAtOrDefault(index),
        Math.Round(Forecast.Daily.Highs.ElementAtOrDefault(index)).ToString("0"),
        Math.Round(Forecast.Daily.Lows.ElementAtOrDefault(index)).ToString("0"),
        Math.Round(Forecast.Daily.PrecipitationChance.ElementAtOrDefault(index)).ToString("0"),
        Math.Round(Forecast.Daily.MaxWindSpeed.ElementAtOrDefault(index)).ToString("0")));

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{SharedCity}|{SharedState}";
        if (string.IsNullOrWhiteSpace(SharedCity) || key == _loadedShare) return;
        _loadedShare = key;
        var matches = await Api.SearchCitiesAsync($"{SharedCity}, {SharedState}");
        var city = matches.FirstOrDefault(item => item.Name.Equals(SharedCity, StringComparison.OrdinalIgnoreCase) &&
            (string.IsNullOrWhiteSpace(SharedState) || item.State?.Equals(SharedState, StringComparison.OrdinalIgnoreCase) == true));
        if (city is not null) await SelectCityAsync(city);
    }

    private async Task SelectCityAsync(CityLocation city) { await Location.SelectAsync(city); await LoadCityAsync(city); }
    private async Task ShareAsync()
    {
        if (City is null) return;
        var query = $"?city={Uri.EscapeDataString(City.Name)}&state={Uri.EscapeDataString(City.State ?? "")}";
        var url = new Uri(new Uri(Navigation.BaseUri), query).ToString();
        try
        {
            var result = await Js.InvokeAsync<string>("wattWeather.share", $"{City.Name} weather", ShareDescription, url);
            _shareStatus = result == "copied" ? "Forecast link copied!" : null;
        }
        catch { _shareStatus = "Sharing is unavailable. Copy the page address instead."; }
    }

    private static string FormatTime(string? value) => DateTime.TryParse(value, out var time) ? time.ToString("h:mm tt") : "—";
    private sealed record ForecastDay(string Name, int Code, string High, string Low, string RainChance, string Wind);
}
