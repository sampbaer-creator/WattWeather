@page "/solar"
@inherits LocationPageBase

<PageTitle>Solar value — WattWeather</PageTitle>

<section class="page-hero">
    <div><span class="kicker">SOLAR VALUE / 6 KW SYSTEM</span><h1>Is rooftop solar worth exploring <em>here?</em></h1><p>Screen local sunlight, expected panel output, and state electricity value before you call an installer.</p></div>
    <div class="score-card"><span>LOCAL SOLAR SIGNAL</span><strong>@(Estimate is null ? "—" : $"{Estimate.Score}")</strong><b>@(Estimate?.Verdict ?? "Choose a city")</b><small>Score out of 100</small></div>
</section>

<section class="search-band compact">
    <div><span class="kicker">LOCATION</span><h2>@(City?.Label ?? "Choose a U.S. city")</h2></div>
    <CityPicker Selected="LoadCityAsync" ButtonText="Update report" />
</section>

@if (Loading) { <div class="loading-line">Loading local solar data…</div> }
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="alert">@Error</div> }

<section class="page-section">
    <div class="metric-grid five">
        <article><span>Daily solar resource</span><strong>@(Estimate?.DailySolarKwhPerSquareMeter.ToString("0.0") ?? "—")</strong><small>kWh/m² forecast avg.</small></article>
        <article><span>Panel layout</span><strong>15</strong><small>400 W panels</small></article>
        <article><span>System size</span><strong>6.0 kW</strong><small>typical home array</small></article>
        <article><span>Annual output</span><strong>@(Estimate is null ? "—" : $"{Estimate.AnnualOutputKwh:N0}")</strong><small>estimated kWh</small></article>
        <article><span>Annual bill value</span><strong>@(Estimate is null ? "—" : $"{Estimate.AnnualBillValue:C0}")</strong><small>at state avg. rate</small></article>
    </div>

    <div class="split-panel">
        <article class="dark-panel">
            <span class="kicker light">HOW THE SYSTEM WORKS</span>
            <h2>15 panels. One practical baseline.</h2>
            <p>Each 400-watt panel creates direct-current power. An inverter converts it for home use. The C# model applies an 80% real-world factor for heat, wiring, inverter, shade, and other losses.</p>
            <div class="panel-stats"><span><b>400 W</b>each</span><span><b>80%</b>factor</span><span><b>6 kW</b>array</span></div>
        </article>
        <article class="panel-map">
            @for (var index = 0; index < 15; index++) { <i></i> }
            <strong>15 × 400 W solar panels</strong>
        </article>
    </div>

    <div class="decision-grid">
        <article><span class="kicker">THE ANSWER</span><h2>@(Estimate?.Verdict ?? "Start with a city.")</h2><p>@(Estimate?.Explanation ?? "Local sunlight and the price of electricity will shape this first-pass result.")</p></article>
        <article><span class="kicker">BEFORE YOU BUY</span><ul class="plain-list"><li>Check roof direction, shade, age, and usable area.</li><li>Compare quotes using the same system size.</li><li>Verify utility interconnection and bill-credit rules.</li><li>Confirm incentives before signing.</li></ul></article>
    </div>
    <div class="method">Screening estimate—not a quote. Seasonal conditions, roof details, equipment, financing, and utility rules can materially change the result.</div>
</section>

@code {
    private SolarEstimate? Estimate { get; set; }
    protected override Task OnLocationLoadedAsync()
    {
        Estimate = Forecast is null ? null : Calculations.CalculateSolar(Forecast, StateEnergy);
        return Task.CompletedTask;
    }
}
