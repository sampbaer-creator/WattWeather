@page "/discounts"
@page "/incentives"
@inject LocationState Location

<PageTitle>Solar discounts — WattWeather</PageTitle>

<section class="page-hero">
    <div><span class="kicker">SOLAR DISCOUNTS / EXPLAINED</span><h1>Find real help without the <em>fine-print fog.</em></h1><p>Understand what changed federally, find location-based programs, and estimate only the rebates you have confirmed.</p></div>
    <div class="status-card"><span>2026 FEDERAL STATUS</span><strong>$0</strong><b>for new homeowner installations</b><small>The federal Residential Clean Energy Credit ended for expenditures after December 31, 2025.</small></div>
</section>

<section class="search-band compact">
    <div><span class="kicker">STATE + LOCAL</span><h2>@(Location.Current?.State is null ? "Choose your state" : $"Programs in {Location.Current.State}")</h2></div>
    <CityPicker Selected="HandleCitySelected" ButtonText="Use location" />
</section>

<section class="page-section">
    <div class="decision-grid">
        <article><span class="kicker">FEDERAL</span><h2>No new homeowner credit in 2026.</h2><p>The former 30% credit generally applied to qualifying property installed from 2022 through December 31, 2025. Prior-year carryforwards require individual tax review.</p><a class="text-link" href="https://www.irs.gov/credits-deductions/residential-clean-energy-credit" target="_blank" rel="noopener noreferrer">Current IRS guidance ↗</a></article>
        <article class="accent-card"><span class="kicker">STATE / CITY / UTILITY</span><h2>Programs depend on your address.</h2><p>Look for rebates, tax exemptions, net-metering credits, and income-qualified programs. Funding and eligibility can change.</p><a class="btn btn-dark" href="https://programs.dsireusa.org/system/program" target="_blank" rel="noopener noreferrer">Search DSIRE ↗</a></article>
    </div>

    <div class="section-intro spaced"><span class="kicker">COMMON PROGRAM TYPES</span><h2>Know what each discount means.</h2></div>
    <div class="type-grid">
        <article><b>01</b><h3>Upfront rebate</h3><p>Cash taken off the price or paid after installation.</p></article>
        <article><b>02</b><h3>Tax benefit</h3><p>A state credit or sales/property-tax exemption.</p></article>
        <article><b>03</b><h3>Bill credits</h3><p>Value for extra solar electricity sent to the grid.</p></article>
        <article><b>04</b><h3>Income-qualified help</h3><p>Additional support based on household eligibility.</p></article>
    </div>

    <section class="calculator">
        <div><span class="kicker light">CONFIRMED DISCOUNT CALCULATOR</span><h2>Start with a written quote.</h2><p>Enter only rebate amounts confirmed by the program administrator, utility, or installer.</p>
            <div class="input-grid">
                <label>System quote <span>$</span><input type="number" min="0" step="100" @bind="Quote" @bind:event="oninput" /></label>
                <label>State/local rebate <span>$</span><input type="number" min="0" step="100" @bind="StateRebate" @bind:event="oninput" /></label>
                <label>Utility rebate <span>$</span><input type="number" min="0" step="100" @bind="UtilityRebate" @bind:event="oninput" /></label>
            </div>
        </div>
        <div class="result-card"><span>ESTIMATED NET COST</span><strong>@Estimate.NetCost.ToString("C0")</strong><dl><div><dt>Confirmed discounts</dt><dd>@Estimate.ConfirmedDiscounts.ToString("C0")</dd></div><div><dt>Price reduction</dt><dd>@Estimate.PercentReduction.ToString("0")%</dd></div><div><dt>2026 federal credit</dt><dd>$0</dd></div></dl></div>
    </section>
    <div class="method">
        Educational estimate only. Confirm funding, eligibility, tax treatment, ownership, and utility rules before making a purchase.
        You can also <a class="text-link" href="https://www.solar-estimate.org/savings-calculator?aff=209744&amp;cam=963&amp;aid=&amp;gid=1322714865355577&amp;cid=662848957&amp;tid=kwd-82670765868074:loc-116006&amp;kw=solar%20tax%20credit&amp;mt=b&amp;lo=96081&amp;msclkid=8791c25c77221bf41753a8347b61267a&amp;utm_source=bing&amp;utm_medium=cpc&amp;utm_campaign=SRCH%20%5BUSA%20Low%20ROAS%20A%20Counties%20CPU%2FMOB%2FTAB%20%2470%20tCPA,%20%2410%20CPC%5D&amp;utm_term=solar%20tax%20credit&amp;utm_content=solar%20tax%20credit%20-%20phrase" target="_blank" rel="noopener noreferrer nofollow">compare the result with the Solar Estimate calculator ↗</a>.
    </div>
</section>

@code {
    private decimal Quote { get; set; } = 24_000;
    private decimal StateRebate { get; set; }
    private decimal UtilityRebate { get; set; }
    private DiscountEstimate Estimate => EnergyCalculations.CalculateDiscount(Quote, StateRebate, UtilityRebate);

    protected override async Task OnInitializedAsync() => await Location.InitializeAsync();
    private Task HandleCitySelected(CityLocation _) { StateHasChanged(); return Task.CompletedTask; }
}
