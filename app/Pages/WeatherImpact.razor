@page "/weather-impact"
@inherits LocationPageBase

<PageTitle>Weather impact — WattWeather</PageTitle>

<section class="page-hero">
    <div><span class="kicker">WEATHER / ENERGY DEMAND</span><h1>See when weather pushes energy use <em>higher.</em></h1><p>Translate current conditions into heating and cooling pressure, then compare long-term city temperature with state household electricity use.</p></div>
    <div class="weather-card"><span>@(City?.Name.ToUpperInvariant() ?? "CHOOSE A CITY")</span><strong>@(Forecast is null ? "—" : $"{Math.Round(Forecast.Current.Temperature)}°")</strong><b>@(Forecast is null ? "Waiting for weather" : EnergyCalculations.WeatherLabel(Forecast.Current.WeatherCode))</b><small>Feels like @(Forecast is null ? "—" : $"{Math.Round(Forecast.Current.FeelsLike)}°F")</small></div>
</section>

<section class="search-band compact">
    <div><span class="kicker">LOCATION</span><h2>@(City?.Label ?? "Choose a U.S. city")</h2></div>
    <CityPicker Selected="LoadCityAsync" ButtonText="Update impact" />
</section>

@if (Loading) { <div class="loading-line">Loading local weather data…</div> }
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="alert">@Error</div> }

<section class="page-section">
    <div class="answer-strip"><span class="kicker">PLAIN-LANGUAGE ANSWER</span><h2>@(Demand?.Summary ?? "Choose a city to measure demand pressure.")</h2></div>
    <div class="metric-grid">
        <article><span>Feels like</span><strong>@(Forecast is null ? "—" : $"{Math.Round(Forecast.Current.FeelsLike)}°F")</strong><small>current apparent temp.</small></article>
        <article><span>Heating pressure</span><strong>@(Demand is null ? "—" : $"{Demand.HeatingPressure:0}°")</strong><small>below 65°F baseline</small></article>
        <article><span>Cooling pressure</span><strong>@(Demand is null ? "—" : $"{Demand.CoolingPressure:0}°")</strong><small>above 65°F baseline</small></article>
        <article><span>State home use</span><strong>@(StateEnergy is null ? "—" : $"{StateEnergy.AverageMonthlyKwh:N0}")</strong><small>kWh/month · EIA</small></article>
    </div>

    <div class="split-panel">
        <article class="chart-panel">
            <span class="kicker">7-DAY TEMPERATURE RANGE</span><h2>Daily highs and lows</h2>
            <div class="temperature-list">
                @if (Forecast is null)
                {
                    <p>Choose a city to build the outlook.</p>
                }
                else
                {
                    @for (var index = 0; index < Forecast.Daily.Dates.Count; index++)
                    {
                        <div><span>@DateTime.Parse(Forecast.Daily.Dates[index]).ToString("ddd")</span><i style="width:@TemperatureWidth(Forecast.Daily.Highs[index])%"></i><b>@Math.Round(Forecast.Daily.Lows[index])° / @Math.Round(Forecast.Daily.Highs[index])°</b></div>
                    }
                }
            </div>
        </article>
        <article class="correlation-panel"><span class="kicker">LONG-TERM SIGNAL</span><h2>City temperature + state home use</h2><strong>@(Correlation.HasValue ? Correlation.Value.ToString("0.00") : "—")</strong><p>@CorrelationText</p></article>
    </div>
    <div class="method">Correlation does not prove causation. Population, efficiency, prices, storms, economic activity, and heating fuel can also change electricity use.</div>
</section>

@code {
    private DemandEstimate? Demand { get; set; }
    private double? Correlation { get; set; }
    private string CorrelationText => Correlation.HasValue
        ? $"{Strength(Correlation.Value)} association across matched annual records."
        : "Choose a U.S. city to compare annual records.";

    protected override async Task OnLocationLoadedAsync()
    {
        Demand = Forecast is null ? null : EnergyCalculations.CalculateDemand(Forecast.Current.FeelsLike);
        Correlation = City is null || StateEnergy is null
            ? null
            : await Api.GetTemperatureUsageCorrelationAsync(City, StateEnergy);
    }

    private static double TemperatureWidth(double temperature) => Math.Clamp((temperature + 10) / 120 * 100, 8, 100);
    private static string Strength(double value) => Math.Abs(value) switch
    {
        < .2 => "Very weak",
        < .4 => "Weak",
        < .6 => "Moderate",
        < .8 => "Strong",
        _ => "Very strong"
    };
}
