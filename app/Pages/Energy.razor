@page "/energy"
@inject EnergyRecordStore Store
@inject EnergyCalculations Calculations

<PageTitle>My energy — WattWeather</PageTitle>

<section class="page-hero">
    <div><span class="kicker">PRIVATE / BROWSER-LOCAL</span><h1>Connect your bill to the <em>weather.</em></h1><p>Add records manually or import a CSV. Your data stays in this browser and is never uploaded to WattWeather.</p></div>
    <div class="energy-score"><span>RECORDS ANALYZED</span><strong>@Summary.RecordCount</strong><b>@(Summary.RecordCount == 0 ? "Ready when you are" : $"{Summary.TotalKilowattHours:N0} total kWh")</b><small>No account · no server storage</small></div>
</section>

<section class="page-section">
    <div class="energy-entry">
        <article>
            <span class="kicker">ADD ONE DAILY RECORD</span><h2>Enter one day of electricity use.</h2>
            <div class="record-form">
                <label>Date<input type="date" @bind="_newRecord.Date" /></label>
                <label>Electricity use (kWh)<input type="number" min="0.01" step="0.01" @bind="_newRecord.KilowattHours" /></label>
                <label>Cost (optional)<input type="number" min="0" step="0.01" @bind="_newRecord.Cost" /></label>
                <label>Mean temperature °F (optional)<input type="number" step="0.1" @bind="_newRecord.MeanTemperature" /></label>
                <button class="btn btn-dark" type="button" @onclick="AddRecordAsync">Save record</button>
            </div>
        </article>
        <article class="accent-card">
            <span class="kicker">IMPORT DAILY CSV</span><h2>Bring daily interval data.</h2><p>Full-history weather matching requires at least three unique daily rows. Required: <code>date</code> and <code>kwh</code>. Optional: <code>cost</code> and <code>temperature</code>. Monthly bills belong in the one-bill tool on Overview.</p>
            <InputFile OnChange="ImportCsvAsync" accept=".csv,text/csv" />
            @if (!string.IsNullOrWhiteSpace(_status)) { <p class="field-status @(_hasError ? "error" : "")">@_status</p> }
        </article>
    </div>

    <div class="metric-grid">
        <article><span>Records</span><strong>@Summary.RecordCount</strong><small>browser-local entries</small></article>
        <article><span>Total usage</span><strong>@Summary.TotalKilowattHours.ToString("N1")</strong><small>kWh</small></article>
        <article><span>Average use</span><strong>@Summary.AverageKilowattHours.ToString("N1")</strong><small>kWh per record</small></article>
        <article><span>Total cost</span><strong>@Summary.TotalCost.ToString("C2")</strong><small>from supplied costs</small></article>
    </div>

    <div class="split-panel">
        <article class="correlation-panel"><span class="kicker">WEATHER CONNECTION</span><h2>Temperature correlation</h2><strong>@(Summary.TemperatureCorrelation?.ToString("0.00") ?? "—")</strong><p>Add at least three records with temperature to calculate Pearson's r.</p></article>
        <article><span class="kicker">DATA QUALITY</span><h2>@Summary.UnusualRecordCount unusual record(s)</h2><p>WattWeather uses the interquartile-range method to flag unusually high usage. A flag is a review prompt, not proof of an error.</p></article>
    </div>
    <div class="method"><strong>Methods:</strong> Pearson's r measures linear temperature–usage association; it does not prove weather caused a bill change. IQR marks values above Q3 + 1.5 × IQR because it resists extreme observations and requires no normal-distribution assumption. HDD/CDD calculations elsewhere use a 65°F baseline. Any regression forecast is an estimate and requires enough daily data.</div>

    <div class="table-heading"><div><span class="kicker">YOUR RECORDS</span><h2>Recent energy use</h2></div>@if (Store.Records.Count > 0) { <button class="text-button" @onclick="ClearAsync">Clear all</button> }</div>
    <div class="table-wrap">
        <table><thead><tr><th>Date</th><th>Usage</th><th>Cost</th><th>Temperature</th><th></th></tr></thead>
        <tbody>
            @if (Store.Records.Count == 0) { <tr><td colspan="5">No energy records yet.</td></tr> }
            @foreach (var record in Store.Records)
            {
                <tr><td>@record.Date.ToString("MMM d, yyyy")</td><td><strong>@record.KilowattHours.ToString("0.00") kWh</strong></td><td>@(record.Cost?.ToString("C2") ?? "—")</td><td>@(record.MeanTemperature.HasValue ? $"{record.MeanTemperature:0.0}°F" : "—")</td><td><button class="text-button" @onclick="() => RemoveAsync(record.Id)">Remove</button></td></tr>
            }
        </tbody></table>
    </div>
</section>

@code {
    private EnergyRecord _newRecord = new() { KilowattHours = 1 };
    private string _status = "";
    private bool _hasError;
    private EnergySummary Summary => EnergyCalculations.Summarize(Store.Records);

    protected override async Task OnInitializedAsync() => await Store.LoadAsync();

    private async Task AddRecordAsync()
    {
        if (_newRecord.KilowattHours <= 0) { _status = "Electricity use must be greater than zero."; _hasError = true; return; }
        await Store.AddAsync(_newRecord);
        _newRecord = new EnergyRecord { KilowattHours = 1, Date = DateOnly.FromDateTime(DateTime.Today) };
        _status = "Record saved in this browser."; _hasError = false;
    }

    private async Task ImportCsvAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await using var stream = args.File.OpenReadStream(2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var imported = await Store.ImportCsvAsync(await reader.ReadToEndAsync());
            _status = $"Imported {imported} valid record(s)."; _hasError = false;
        }
        catch (Exception exception) { _status = exception.Message; _hasError = true; }
    }

    private async Task RemoveAsync(Guid id) => await Store.RemoveAsync(id);
    private async Task ClearAsync() => await Store.ClearAsync();
}
