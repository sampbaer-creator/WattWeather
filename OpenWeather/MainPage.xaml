<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:OpenWeather.ViewModels" x:DataType="vm:WeatherViewModel" x:Class="OpenWeather.MainPage" BackgroundColor="#FBFAF5" Title="WattWeather">
 <ScrollView><VerticalStackLayout Padding="28" Spacing="20" MaximumWidthRequest="820">
  <Label Text="WEATHER × ENERGY INTELLIGENCE" TextColor="#FF7657" FontAttributes="Bold" CharacterSpacing="2"/>
  <Label Text="Weather, with context." FontSize="44" FontAttributes="Bold" TextColor="#013E37"/>
  <Label Text="Search live conditions by ZIP code or city. Your API key stays outside source control." FontSize="16" TextColor="#60716D"/>
  <Border BackgroundColor="#FFefb3" StrokeThickness="0" Padding="22" StrokeShape="RoundRectangle 20"><VerticalStackLayout Spacing="14">
   <Entry Text="{Binding Query}" Placeholder="Denver, CO or 80202" BackgroundColor="White" HeightRequest="52"/>
   <Button Text="Get weather →" Command="{Binding SearchCommand}" BackgroundColor="#013E37" TextColor="White" HeightRequest="52" CornerRadius="26"/>
   <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#FF7657"/><Label Text="{Binding ErrorMessage}" TextColor="#9D3828"/>
  </VerticalStackLayout></Border>
  <Border IsVisible="{Binding HasWeather}" BackgroundColor="#013E37" StrokeThickness="0" Padding="28" StrokeShape="RoundRectangle 24"><VerticalStackLayout Spacing="10">
   <Label Text="{Binding LocationLabel}" TextColor="#FFefb3" FontAttributes="Bold"/><Label Text="{Binding TemperatureLabel}" TextColor="White" FontSize="72" FontAttributes="Bold"/><Label Text="{Binding DescriptionLabel}" TextColor="#E7F2ED" FontSize="17"/>
   <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12"><Label Text="{Binding HighLowLabel}" TextColor="White"/><Label Grid.Column="1" Text="{Binding HumidityLabel}" TextColor="White"/><Label Grid.Row="1" Text="{Binding WindLabel}" TextColor="White"/><Label Grid.Row="1" Grid.Column="1" Text="{Binding SunLabel}" TextColor="White"/></Grid>
  </VerticalStackLayout></Border>
  <Label Text="Analytics and forecasting are also available in the WattWeather web app." TextColor="#60716D" HorizontalTextAlignment="Center"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
