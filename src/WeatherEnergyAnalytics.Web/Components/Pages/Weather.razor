@page "/weather"
@rendermode InteractiveServer
@inject IWeatherService WeatherService
<PageTitle>Weather — WattWeather</PageTitle>
<section class="page-hero compact"><span class="eyebrow"><i></i> LIVE CONDITIONS</span><h1>Weather, with <em>context.</em></h1><p>Search by US ZIP code or city. Live requests require a locally configured OpenWeather API key.</p></section>
<section class="workspace">
 <div class="search-panel"><input @bind="query" @bind:event="oninput" placeholder="Denver, CO or 80202"/><button class="button primary" @onclick="SearchAsync" disabled="@loading">@(loading?"Searching…":"Get weather →")</button></div>
 @if(error is not null){<div class="notice error">@error</div>}
 @if(weather is not null){<article class="current-weather"><div><span class="card-label">@weather.City.ToUpperInvariant(), @(weather.Region??weather.CountryCode)</span><h2>@weather.TemperatureF.ToString("0")°</h2><p>@weather.Description · Feels like @weather.FeelsLikeF.ToString("0")°</p></div><div class="weather-facts"><span><small>High / low</small>@weather.HighTemperatureF.ToString("0")° / @weather.LowTemperatureF.ToString("0")°</span><span><small>Humidity</small>@weather.HumidityPercent.ToString("0")%</span><span><small>Wind</small>@weather.WindSpeedMph.ToString("0.0") mph</span><span><small>Sunrise / sunset</small>@weather.Sunrise.ToString("h:mm tt") / @weather.Sunset.ToString("h:mm tt")</span></div></article>}
 else{<div class="empty-state"><span>☀</span><h3>Ready when you are</h3><p>Configure your API key, then search for a location.</p></div>}
</section>
@code {private string query="Denver, CO";private bool loading;private string? error;private WeatherSnapshot? weather;private async Task SearchAsync(){loading=true;error=null;try{weather=await WeatherService.GetCurrentAsync(query);}catch(Exception ex){error=ex.Message;}finally{loading=false;}}}
