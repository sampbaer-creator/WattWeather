@page "/analytics"
@inject IEnergyRepository Repository
@inject IAnalyticsService AnalyticsService
<PageTitle>Analytics — WattWeather</PageTitle>
<section class="page-hero compact"><span class="eyebrow"><i></i> BUSINESS INTELLIGENCE</span><h1>Energy patterns, <em>made visible.</em></h1><p>Two years of deterministic sample data power these statistical KPIs.</p></section>
@if(summary is not null){<section class="workspace">
 <div class="kpi-grid">
  <article><span>Total usage</span><strong>@summary.TotalUsageKwh.ToString("N0")</strong><small>kWh</small></article><article><span>Daily average</span><strong>@summary.AverageDailyUsageKwh.ToString("0.0")</strong><small>kWh / day</small></article><article><span>Total cost</span><strong>@summary.TotalCost.ToString("C0")</strong><small>observed period</small></article><article><span>Monthly estimate</span><strong>@summary.EstimatedMonthlyCost.ToString("C0")</strong><small>@summary.EstimatedMonthlyUsageKwh.ToString("0") kWh</small></article><article><span>Temp correlation</span><strong>@summary.TemperatureUsageCorrelation.ToString("+0.00;-0.00;0.00")</strong><small>Pearson r</small></article><article><span>Unusual days</span><strong>@summary.Anomalies.Count</strong><small>IQR method</small></article>
 </div>
 <div class="dashboard-grid">
  <article class="chart-card wide"><div class="chart-title"><div><span>Energy usage over time</span><small>Most recent 60 days · kWh</small></div></div><div class="bar-chart">@foreach(var p in points.TakeLast(60)){<i title="@($"{p.Date}: {p.UsageKwh:0.0} kWh")" style="height:@(Math.Clamp(p.UsageKwh/maxUsage*100,3,100))%"></i>}</div></article>
  <article class="chart-card"><div class="chart-title"><div><span>Usage distribution</span><small>Summary statistics</small></div></div><div class="metric-list"><span>Median <b>@summary.MedianUsageKwh.ToString("0.0") kWh</b></span><span>Minimum <b>@summary.MinimumUsageKwh.ToString("0.0") kWh</b></span><span>Maximum <b>@summary.MaximumUsageKwh.ToString("0.0") kWh</b></span><span>Std. deviation <b>@summary.StandardDeviationKwh.ToString("0.0") kWh</b></span></div></article>
  <article class="chart-card"><div class="chart-title"><div><span>Weather sensitivity</span><small>Degree-day totals</small></div></div><div class="degree-ring"><strong>@summary.HeatingDegreeDays.ToString("N0")</strong><span>heating degree days</span></div><p class="muted">@summary.CoolingDegreeDays.ToString("N0") cooling degree days at a 65°F base.</p></article>
 </div>
</section>}
@code {private AnalyticsSummary? summary;private EnergyDataPoint[] points=[];private double maxUsage=1;protected override async Task OnInitializedAsync(){var rows=await Repository.GetAsync();points=rows.OrderBy(x=>x.UsageDate).Select(Home.ToPoint).ToArray();summary=AnalyticsService.Calculate(points);maxUsage=points.Length==0?1:points.Max(x=>x.UsageKwh);}}
